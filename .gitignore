# ==========================================
# RescueDrone .gitignore
# ==========================================

# Compiled Java Bytecode & Build Artifacts
backend/bin/
bin/
*.class
*.jar
*.war
*.ear
sources.txt

# Frontend Dependencies & Production Bundles
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.vite/
frontend/.vite/

# NPM / Yarn / PNPM Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Local Overrides
.env.local
.env.*.local
*.local

# Temporary & Swap Files
*.tmp
*.temp
*.bak
*.swp
*.swo

# IDE & Editor Configurations
.vscode/
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# OS System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes

# Test Logs & Transient Artifacts
test_output.txt
*.log
